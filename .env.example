# NemoClaw OpenClaw Sandbox example environment file
# Copy values carefully into a local-only file if you use environment-based workflows.
# Do not commit real credentials.

DOMAIN=sandbox.example.cloud
SANDBOX_NAME=nemoclaw-sandbox
REPO_URL=https://github.com/thanhan92-f1/nemoclaw-openclaw-sandbox.git
REPO_REF=main

# Optional provider secrets
NVIDIA_API_KEY=nvapi-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Optional Telegram channel integration
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOW_USER_ID=123456789

# Optional installer overrides for rollback or pinned automation
OPENSHELL_INSTALL_URL=https://raw.githubusercontent.com/NVIDIA/OpenShell/main/install.sh
NEMOCLAW_INSTALL_URL=https://nvidia.com/nemoclaw.sh